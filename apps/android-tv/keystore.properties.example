# Optional local release signing (never commit the real file).
# Copy to keystore.properties and fill in values, or set BULWARK_TV_STORE_* env vars.
#
# CI uses the same env vars after decoding BULWARK_TV_KEYSTORE_BASE64
# (see docs/play-release.md).
#
# storeFile=../release.keystore
# storePassword=
# keyAlias=bulwark-tv
# keyPassword=

storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=bulwark-tv
keyPassword=CHANGE_ME
