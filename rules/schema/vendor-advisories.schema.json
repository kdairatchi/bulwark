{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bulwrk curated vendor/distro advisories",
  "type": "object",
  "required": ["version", "updatedAt", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "cveId", "vendor", "product", "aliases", "severity"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "description": "Stable advisory id (vendor/distro reference or synthetic key)"
          },
          "cveId": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
          "vendor": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "ecosystem": {
            "type": "string",
            "enum": ["windows", "macos", "linux", "debian", "ubuntu", "rhel", "generic"]
          },
          "introduced": {
            "type": "string",
            "description": "First affected version (inclusive)"
          },
          "fixedIn": {
            "type": "string",
            "description": "First fixed version (inclusive)"
          },
          "vulnerableBelow": {
            "type": "string",
            "description": "KEV-style alias for fixedIn (flag when installed < this)"
          },
          "requiredAction": { "type": "string" },
          "reference": { "type": "string" }
        }
      }
    }
  }
}
