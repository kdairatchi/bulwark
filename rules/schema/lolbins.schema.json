{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bulwrk LotL / technique grep catalog",
  "type": "object",
  "required": ["version", "updatedAt", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "platforms", "surfaces", "severity", "detectionName", "details"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "category": { "type": "string", "enum": ["lolbin", "lolscript", "technique", "vuln_heuristic"] },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["win32", "darwin", "linux", "all"] }
          },
          "binPatterns": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "argsPattern": { "type": "string" },
          "combinedPattern": { "type": "string" },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["cmdline", "script", "lnk", "registry", "task", "content"]
            }
          },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "detectionName": { "type": "string", "minLength": 1 },
          "details": { "type": "string", "minLength": 1 },
          "mitre": {
            "type": "array",
            "items": { "type": "string" }
          },
          "minHits": { "type": "integer", "minimum": 1 }
        },
        "anyOf": [
          { "required": ["combinedPattern"] },
          { "required": ["binPatterns"] }
        ]
      }
    }
  }
}
