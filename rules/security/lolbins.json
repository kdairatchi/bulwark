{
  "version": "1.0.0",
  "updatedAt": "2026-07-28T00:00:00Z",
  "description": "Offline Living-off-the-Land (LOLBAS/LOLScripts) + high-confidence technique grep rules. Not a live zero-day feed — static heuristics for cmdlines, scripts, LNK, registry, and tasks.",
  "rules": [
    {
      "id": "lolbas.mshta.remote",
      "category": "lolbin",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])mshta(\\.exe)?$"],
      "argsPattern": "(?i)(https?:|vbscript:|javascript:)",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "high",
      "detectionName": "LOLBin.Mshta.RemoteScript",
      "details": "mshta used to run remote or script protocol content (LOLBAS T1218.005)",
      "mitre": ["T1218.005"]
    },
    {
      "id": "lolbas.certutil.decode",
      "category": "lolbin",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])certutil(\\.exe)?$"],
      "argsPattern": "(?i)(-decode|-urlcache|-encodehex)",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "high",
      "detectionName": "LOLBin.Certutil.DecodeDownload",
      "details": "certutil decode/urlcache abuse for payload staging",
      "mitre": ["T1140", "T1105"]
    },
    {
      "id": "lolbas.bitsadmin.transfer",
      "category": "lolbin",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])bitsadmin(\\.exe)?$"],
      "argsPattern": "(?i)(/transfer|/create|/addfile|/resume)",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "high",
      "detectionName": "LOLBin.Bitsadmin.Transfer",
      "details": "bitsadmin used to download or stage files",
      "mitre": ["T1197"]
    },
    {
      "id": "lolbas.regsvr32.scripthost",
      "category": "lolbin",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])regsvr32(\\.exe)?$"],
      "argsPattern": "(?i)(/s\\s+/n\\s+/u|/i:(http|https|ftp|scp)|scrobj\\.dll)",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "high",
      "detectionName": "LOLBin.Regsvr32.ScriptHost",
      "details": "regsvr32 Squiblydoo / scriptlet execution",
      "mitre": ["T1218.010"]
    },
    {
      "id": "lolbas.rundll32.javascript",
      "category": "lolbin",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])rundll32(\\.exe)?$"],
      "argsPattern": "(?i)(javascript:|mshtml|url\\.dll.*FileProtocolHandler)",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "high",
      "detectionName": "LOLBin.Rundll32.JavaScript",
      "details": "rundll32 used with javascript: or URL handler abuse",
      "mitre": ["T1218.011"]
    },
    {
      "id": "lolbas.cmstp.inf",
      "category": "lolbin",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])cmstp(\\.exe)?$"],
      "argsPattern": "(?i)(/s|/ns).*\\.inf",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "high",
      "detectionName": "LOLBin.Cmstp.Inf",
      "details": "cmstp INF abuse for code execution / UAC bypass patterns",
      "mitre": ["T1218.003"]
    },
    {
      "id": "lolbas.msiexec.remote",
      "category": "lolbin",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])msiexec(\\.exe)?$"],
      "argsPattern": "(?i)(/i\\s+https?:|/q[nby]?\\s+/i\\s+https?:)",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "high",
      "detectionName": "LOLBin.Msiexec.RemoteMsi",
      "details": "msiexec installing from a remote HTTP(S) MSI",
      "mitre": ["T1218.007"]
    },
    {
      "id": "lolbas.wmic.process",
      "category": "lolbin",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])wmic(\\.exe)?$"],
      "argsPattern": "(?i)process\\s+call\\s+create",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "high",
      "detectionName": "LOLBin.Wmic.ProcessCreate",
      "details": "wmic process call create for lateral/local execution",
      "mitre": ["T1047"]
    },
    {
      "id": "lolbas.installutil",
      "category": "lolbin",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])installutil(\\.exe)?$"],
      "argsPattern": "(?i)(/logfile=|/logtoconsole=|/u\\s)",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "medium",
      "detectionName": "LOLBin.InstallUtil.ProxyExec",
      "details": "InstallUtil proxy execution of .NET assemblies",
      "mitre": ["T1218.004"]
    },
    {
      "id": "lolbas.msbuild.inline",
      "category": "lolbin",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])msbuild(\\.exe)?$"],
      "argsPattern": "(?i)(/p:|/t:|\\.xml|\\.csproj|\\.proj)",
      "surfaces": ["cmdline", "script", "task"],
      "severity": "medium",
      "detectionName": "LOLBin.Msbuild.InlineTask",
      "details": "msbuild used as a LOLBin for inline task / project execution",
      "mitre": ["T1127.001"]
    },
    {
      "id": "lolbas.powershell.encoded",
      "category": "lolscript",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])(powershell|pwsh|powershell_ise)(\\.exe)?$"],
      "argsPattern": "(?i)(-e(nc(odedcommand)?)?\\s+[A-Za-z0-9+/=]{20,}|-enc\\s+[A-Za-z0-9+/=]{20,})",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "critical",
      "detectionName": "LOLScript.PowerShell.EncodedCommand",
      "details": "PowerShell encoded command — common malware staging",
      "mitre": ["T1059.001", "T1027"]
    },
    {
      "id": "lolbas.powershell.download_cradle",
      "category": "lolscript",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])(powershell|pwsh)(\\.exe)?$"],
      "argsPattern": "(?i)(downloadstring|downloadfile|invoke-webrequest|\\biwr\\b|invoke-expression|\\biex\\b|frombase64string)",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task", "content"],
      "severity": "critical",
      "detectionName": "LOLScript.PowerShell.DownloadCradle",
      "details": "PowerShell download / IEX cradle",
      "mitre": ["T1059.001", "T1105"]
    },
    {
      "id": "lolbas.powershell.hidden",
      "category": "lolscript",
      "platforms": ["win32"],
      "binPatterns": ["(?i)(^|[\\\\/])(powershell|pwsh)(\\.exe)?$"],
      "argsPattern": "(?i)(-w(indowstyle)?\\s+(hidden|h)\\b|-noprofile.*-noninteractive)",
      "surfaces": ["cmdline", "lnk", "registry", "task"],
      "severity": "medium",
      "detectionName": "LOLScript.PowerShell.HiddenWindow",
      "details": "PowerShell launched hidden / non-interactive from persistence-like surfaces",
      "mitre": ["T1059.001", "T1564.003"]
    },
    {
      "id": "lolbas.cmd.lolbin_chain",
      "category": "lolbin",
      "platforms": ["win32"],
      "combinedPattern": "(?i)cmd(\\.exe)?\\s+/c.*(certutil|bitsadmin|mshta|regsvr32|rundll32\\s+javascript)",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "high",
      "detectionName": "LOLBin.Cmd.ChainedLolbin",
      "details": "cmd /c chaining into a known LOLBin",
      "mitre": ["T1059.003", "T1218"]
    },
    {
      "id": "technique.amsi_bypass",
      "category": "technique",
      "platforms": ["win32"],
      "combinedPattern": "(?i)(amsiutils|amsi\\.dll|amsiScanBuffer|System\\.Management\\.Automation\\.AmsiUtils|amsiInitFailed)",
      "surfaces": ["script", "content", "cmdline"],
      "severity": "critical",
      "detectionName": "Technique.AMSI.Bypass",
      "details": "AMSI bypass / patch patterns (static heuristic, not a CVE ID)",
      "mitre": ["T1562.001"]
    },
    {
      "id": "technique.etw_bypass",
      "category": "technique",
      "platforms": ["win32"],
      "combinedPattern": "(?i)(etw(event|provider).*patch|ntdll\\.dll.*EtwEventWrite|DisableETW|etwEnabled\\s*=\\s*0)",
      "surfaces": ["script", "content", "cmdline"],
      "severity": "high",
      "detectionName": "Technique.ETW.Bypass",
      "details": "ETW patching / disable patterns often used with AMSI bypass",
      "mitre": ["T1562.006"]
    },
    {
      "id": "technique.reflective_load",
      "category": "technique",
      "platforms": ["win32"],
      "combinedPattern": "(?i)(reflection\\.assembly]::load|unsafe\\.aspointer|virtualalloc.*createthread|system\\.reflection\\.emit)",
      "surfaces": ["script", "content"],
      "severity": "high",
      "detectionName": "Technique.DotNet.ReflectiveLoad",
      "details": "In-memory .NET assembly load / emit patterns",
      "mitre": ["T1620", "T1055"]
    },
    {
      "id": "technique.shellcode_keywords",
      "category": "technique",
      "platforms": ["win32", "linux", "darwin"],
      "combinedPattern": "(?i)(\\\\x90\\\\x90\\\\x90|virtualallocex|ntwritevirtualmemory|createremotethread|queueuserapc|mprotect\\s*\\(.*PROT_EXEC)",
      "surfaces": ["script", "content"],
      "severity": "high",
      "detectionName": "Technique.Memory.InjectionPrimitives",
      "details": "Classic process-injection / shellcode staging API strings",
      "mitre": ["T1055"]
    },
    {
      "id": "technique.macro_autoopen",
      "category": "technique",
      "platforms": ["win32", "darwin"],
      "combinedPattern": "(?i)(AutoOpen|Document_Open|Workbook_Open|Auto_Open).*?(Shell|WScript\\.Shell|powershell|mshta)",
      "surfaces": ["script", "content"],
      "severity": "high",
      "detectionName": "Technique.Office.AutoOpenShell",
      "details": "Office auto-open macros invoking shell / LOLBins",
      "mitre": ["T1059", "T1204.002"]
    },
    {
      "id": "technique.webshell_markers",
      "category": "technique",
      "platforms": ["all"],
      "combinedPattern": "(?i)(eval\\s*\\(\\s*\\$_(GET|POST|REQUEST)|assert\\s*\\(\\s*\\$_(POST|GET)|cmd\\.exe\\s*/c\\s*.*\\$_(GET|POST)|passthru\\s*\\(\\s*\\$_)",
      "surfaces": ["script", "content"],
      "severity": "critical",
      "detectionName": "Technique.WebShell.EvalInput",
      "details": "Common webshell eval/assert on request input (static heuristic)",
      "mitre": ["T1505.003"]
    },
    {
      "id": "linux.curl_bash_pipe",
      "category": "lolscript",
      "platforms": ["linux", "darwin"],
      "combinedPattern": "(?i)(curl|wget)\\s+[^|\\n]{0,200}\\|\\s*(ba)?sh\\b",
      "surfaces": ["cmdline", "script", "content", "task"],
      "severity": "high",
      "detectionName": "LOLScript.Curl.PipeToShell",
      "details": "curl/wget piped directly into a shell",
      "mitre": ["T1059.004", "T1105"]
    },
    {
      "id": "linux.base64_decode_exec",
      "category": "technique",
      "platforms": ["linux", "darwin"],
      "combinedPattern": "(?i)(echo\\s+[A-Za-z0-9+/=]{40,}\\s*\\|\\s*base64\\s+-d|base64\\s+-d.*\\|\\s*(ba)?sh)",
      "surfaces": ["cmdline", "script", "content"],
      "severity": "high",
      "detectionName": "Technique.Unix.Base64DecodeExec",
      "details": "Base64 decode piped to shell — common stager",
      "mitre": ["T1027", "T1059.004"]
    },
    {
      "id": "darwin.osascript_curl",
      "category": "lolscript",
      "platforms": ["darwin"],
      "binPatterns": ["(?i)(^|/)osascript$"],
      "argsPattern": "(?i)(curl|do\\s+shell\\s+script|https?:)",
      "surfaces": ["cmdline", "script", "task"],
      "severity": "high",
      "detectionName": "LOLScript.Osascript.RemoteShell",
      "details": "osascript invoking shell / remote fetch",
      "mitre": ["T1059.002"]
    },
    {
      "id": "technique.suspicious_temp_exec",
      "category": "technique",
      "platforms": ["win32"],
      "combinedPattern": "(?i)(%temp%|\\\\temp\\\\|\\\\appdata\\\\local\\\\temp\\\\)[^\\s\"']+\\.(exe|dll|bat|cmd|ps1|vbs|js|hta)\\b",
      "surfaces": ["cmdline", "registry", "task", "lnk"],
      "severity": "medium",
      "detectionName": "Technique.Temp.ExecutableFromTemp",
      "details": "Execution or persistence pointing at a temp-path executable/script",
      "mitre": ["T1105", "T1547.001"]
    },
    {
      "id": "technique.zerodayish.unsigned_script_host",
      "category": "technique",
      "platforms": ["win32"],
      "combinedPattern": "(?i)(cscript|wscript)(\\.exe)?\\s+.*(https?:|\\\\\\\\|%temp%|\\\\users\\\\[^\\\\]+\\\\appdata\\\\).*\\.(js|vbs|wsf)",
      "surfaces": ["cmdline", "script", "lnk", "registry", "task"],
      "severity": "high",
      "detectionName": "Technique.ScriptHost.RemoteOrTemp",
      "details": "WScript/CScript running remote or temp scripts (common 0-day dropper pattern)",
      "mitre": ["T1059.005", "T1059.007"]
    }
  ]
}
